---
import type { Entry } from "../lib/content";
import { formatDate, isoDate, summarise } from "../lib/content";

interface Props {
  post: Entry;
  showImage?: boolean;
}

const { post, showImage = true } = Astro.props;
const excerpt = summarise(post, 130);
---

<article class="post-card">
  {showImage && (
    post.featuredImage ? (
      <a class="post-card__media" href={post.path} tabindex="-1" aria-hidden="true">
        <img src={post.featuredImage} alt="" loading="lazy" decoding="async" />
      </a>
    ) : (
      <a class="post-card__media post-card__media--blank" href={post.path} tabindex="-1" aria-hidden="true">
        <span class="post-card__brand">Schoonmakerweb</span>
      </a>
    )
  )}
  <div class="post-card__body">
    {post.date && (
      <p class="post-card__date">
        <time datetime={isoDate(post.date)}>{formatDate(post.date)}</time>
      </p>
    )}
    <h3><a href={post.path}>{post.title}</a></h3>
    {excerpt && <p class="post-card__excerpt">{excerpt}</p>}
    <a class="post-card__more" href={post.path}>Lees meer »</a>
  </div>
</article>
