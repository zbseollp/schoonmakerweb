---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Archive from "../../components/Archive.astro";
import Pagination from "../../components/Pagination.astro";
import { pageByPath, posts, chunk } from "../../lib/content";
import { site, ARCHIVE_PER_PAGE as PER } from "../../data/site";

// /blog/ is the paginated archive. The old Elementor page HTML is a frozen
// post list — skip it so the live collection drives the cards.
const page = pageByPath("/blog/");
const pages = chunk(posts, PER);
---

<BaseLayout
  title={page?.seoTitle || `Onze blogs${site.titleSuffix}`}
  description={page?.seoDescription || site.description}
  canonical={`${site.domain}/blog/`}
>
  <section class="blog-hero">
    <div class="wrap blog-hero__inner">
      <p class="blog-hero__eyebrow">Blog</p>
      <h1 class="blog-hero__title">{page?.title || "Onze blogs"}</h1>
      <p class="blog-hero__lead">
        Tips, vergelijkingen en praktische gidsen voor een schoner huis — {posts.length} artikelen.
      </p>
    </div>
  </section>

  <section class="section wrap">
    <Archive posts={pages[0] ?? []} />
    <Pagination
      current={1}
      total={pages.length}
      href={(n) => (n === 1 ? "/blog/" : `/blog/page/${n}/`)}
    />
  </section>
</BaseLayout>
