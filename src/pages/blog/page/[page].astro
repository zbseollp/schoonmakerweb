---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Archive from "../../../components/Archive.astro";
import Pagination from "../../../components/Pagination.astro";
import { posts, chunk } from "../../../lib/content";
import { site, ARCHIVE_PER_PAGE as PER } from "../../../data/site";

export function getStaticPaths() {
  const pages = chunk(posts, PER);
  return pages.slice(1).map((items, i) => ({
    params: { page: String(i + 2) },
    props: { n: i + 2, total: pages.length, items },
  }));
}

const { n, total, items } = Astro.props;
---

<BaseLayout
  title={`Onze blogs - pagina ${n}${site.titleSuffix}`}
  canonical={`${site.domain}/blog/page/${n}/`}
  noindex
>
  <section class="blog-hero blog-hero--compact">
    <div class="wrap blog-hero__inner">
      <p class="blog-hero__eyebrow">Blog</p>
      <h1 class="blog-hero__title">Onze blogs</h1>
      <p class="blog-hero__lead">Pagina {n} van {total}</p>
    </div>
  </section>

  <section class="section wrap">
    <Archive posts={items} />
    <Pagination
      current={n}
      total={total}
      href={(p) => (p === 1 ? "/blog/" : `/blog/page/${p}/`)}
    />
  </section>
</BaseLayout>
